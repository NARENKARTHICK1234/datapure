# DataPure — Required Environment Variables
# Copy this file to .env for local development.
# Never commit .env to Git.

# ── Backend ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (Render URL after deploy).
# Example: https://datapure-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Frontend ─────────────────────────────────────────────────────────────────
# Full URL of the deployed Render backend (no trailing slash).
# Leave blank for local dev (Vite proxy handles /api/* automatically).
# Example: https://datapure-backend.onrender.com
VITE_API_URL=
